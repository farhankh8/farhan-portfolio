{
  "outputDirectory": ".",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "routes": [
    {
      "src": "/style.css",
      "headers": {
        "content-type": "text/css"
      }
    },
    {
      "src": "/tailwind.css",
      "headers": {
        "content-type": "text/css"
      }
    },
    {
      "src": "/app.js",
      "headers": {
        "content-type": "application/javascript"
      }
    },
    {
      "src": "/favicon.svg",
      "headers": {
        "content-type": "image/svg+xml"
      }
    },
    {
      "src": "/og-image.png",
      "headers": {
        "content-type": "image/png"
      }
    },
    {
      "src": "/(privacy)",
      "dest": "/privacy.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
